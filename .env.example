APP_NAME=AutoIQ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://autoiq.test

APP_LOCALE=sr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sr_RS
APP_TIMEZONE=Europe/Belgrade

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autoiq
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=false
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

POL_AUTO_IMPORT_ENABLED=false
POL_AUTO_IMPORT_ALLOW_FETCH=false
POL_AUTO_IMPORT_AUTO_PUBLISH=false
POL_AUTO_IMPORT_OWNER_EMAIL=admin@autoiq.rs
POL_AUTO_IMPORT_TIMEOUT=15
POL_AUTO_IMPORT_CONNECT_TIMEOUT=10
POL_AUTO_IMPORT_DELAY_MS=1500
POL_AUTO_IMPORT_USER_AGENT="AutoIQ Import Monitor/1.0 (+https://autoiq.rs)"

MOJAUTO_IMPORT_ENABLED=false
MOJAUTO_IMPORT_ALLOW_FETCH=false
MOJAUTO_IMPORT_AUTO_PUBLISH=true
MOJAUTO_IMPORT_OWNER_EMAIL=admin@autoiq.rs
MOJAUTO_IMPORT_TIMEOUT=15
MOJAUTO_IMPORT_CONNECT_TIMEOUT=10
MOJAUTO_IMPORT_DELAY_MS=1000
MOJAUTO_IMPORT_USER_AGENT="AutoIQ Import Monitor/1.0 (+https://autoiq.rs)"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/nalog/google/povratak"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/nalog/facebook/povratak"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
